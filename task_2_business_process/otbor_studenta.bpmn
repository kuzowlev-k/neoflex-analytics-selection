<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_UC" name="Отбор студента в УЦ" processRef="Process_Selection" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Selection" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Студент">
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Tests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LMS" name="LMS">
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AllDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCreds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UC" name="Команда УЦ">
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Top</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectTop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectTop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_Login" name="Войти в LMS УЦ">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess_Tests" name="Прохождение 3 обязательных тестирований (в любом порядке)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:startEvent id="Start_Sub">
        <bpmn:outgoing>S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="Gw_Split">
        <bpmn:incoming>S1</bpmn:incoming>
        <bpmn:outgoing>S2</bpmn:outgoing>
        <bpmn:outgoing>S3</bpmn:outgoing>
        <bpmn:outgoing>S4</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Task_Survey" name="Заполнить анкету">
        <bpmn:incoming>S2</bpmn:incoming>
        <bpmn:outgoing>S5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_Test" name="Выполнить тест">
        <bpmn:incoming>S3</bpmn:incoming>
        <bpmn:outgoing>S6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_Case" name="Сделать кейс">
        <bpmn:incoming>S4</bpmn:incoming>
        <bpmn:outgoing>S7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="Gw_Join">
        <bpmn:incoming>S5</bpmn:incoming>
        <bpmn:incoming>S6</bpmn:incoming>
        <bpmn:incoming>S7</bpmn:incoming>
        <bpmn:outgoing>S8</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="End_Sub">
        <bpmn:incoming>S8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="S1" sourceRef="Start_Sub" targetRef="Gw_Split" />
      <bpmn:sequenceFlow id="S2" sourceRef="Gw_Split" targetRef="Task_Survey" />
      <bpmn:sequenceFlow id="S3" sourceRef="Gw_Split" targetRef="Task_Test" />
      <bpmn:sequenceFlow id="S4" sourceRef="Gw_Split" targetRef="Task_Case" />
      <bpmn:sequenceFlow id="S5" sourceRef="Task_Survey" targetRef="Gw_Join" />
      <bpmn:sequenceFlow id="S6" sourceRef="Task_Test" targetRef="Gw_Join" />
      <bpmn:sequenceFlow id="S7" sourceRef="Task_Case" targetRef="Gw_Join" />
      <bpmn:sequenceFlow id="S8" sourceRef="Gw_Join" targetRef="End_Sub" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Timer" name="3 недели" attachedToRef="SubProcess_Tests">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_21d">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">P21D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_Merge">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Check" name="Проверить выполнение 3 пунктов">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_AllDone" name="Все 3 пункта выполнены?" default="Flow_10">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectIncomplete" name="Отправить отказ на почту">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RejectIncomplete" name="Отбор завершён: не выполнены все этапы">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Review" name="Оценить ответы анкеты, теста и кейса">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Top" name="Студент в топе по критериям?" default="Flow_14">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectTop" name="Отправить отказ на почту">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RejectTop" name="Отбор завершён: не приглашён на собеседование" storm:LabelWidth="115" storm:LabelHeight="31">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Reply" name="Выбрать дату собеседования">
      <bpmn:documentation>Студент читает приглашение и решает: выбрать дату или отказаться. На решение даётся 7 дней.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Reply" name="7 дней" attachedToRef="Task_Reply">
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_7d">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_Agree" name="Студент согласен на собеседование?" default="Flow_20">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendDecline" name="Отправить письмо об отказе">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Book" name="Обработать дату и подтвердить бронь">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Declined" name="Студент отказался от собеседования">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Timeout" name="Студент не ответил в срок">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Form" targetRef="Task_Fill" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Fill" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Register" targetRef="Task_SendCreds" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SendCreds" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Login" targetRef="SubProcess_Tests" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="SubProcess_Tests" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Boundary_Timer" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_Merge" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Check" targetRef="Gw_AllDone" />
    <bpmn:sequenceFlow id="Flow_10" name="Нет" sourceRef="Gw_AllDone" targetRef="Task_RejectIncomplete" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RejectIncomplete" targetRef="End_RejectIncomplete" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Gw_AllDone" targetRef="Task_Review">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">все пункты выполнены</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Review" targetRef="Gw_Top" />
    <bpmn:sequenceFlow id="Flow_14" name="Нет" sourceRef="Gw_Top" targetRef="Task_RejectTop" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RejectTop" targetRef="End_RejectTop" />
    <bpmn:sequenceFlow id="Flow_16" name="Да" sourceRef="Gw_Top" targetRef="Task_Invite">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">студент в топе</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Invite" targetRef="Task_Reply" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Reply" targetRef="Gw_Agree" />
    <bpmn:sequenceFlow id="Flow_19" name="Да" sourceRef="Gw_Agree" targetRef="Task_SendDate">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">студент выбрал дату</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Нет" sourceRef="Gw_Agree" targetRef="Task_SendDecline" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SendDate" targetRef="Task_ReceiveDate" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ReceiveDate" targetRef="Task_Book" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Book" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Confirm" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_SendDecline" targetRef="End_Declined" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Boundary_Reply" targetRef="End_Timeout" />
    <bpmn:sendTask id="Task_Invite" name="Отправить приглашение на собеседование">
      <bpmn:documentation>Письмо с просьбой выбрать дату собеседования и ответить на письмо.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Fill" name="Заполнить и отправить форму заявки">
      <bpmn:documentation>Поля формы: программа обучения, имя, почта, телефон.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_Form" name="Открылась форма заявки на сайте УЦ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_ReceiveDate" name="Получить письмо с выбранной датой">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End_Success" name="Дата собеседования подтверждена">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Confirm" name="Отправить подтверждение даты">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendDate" name="Отправить письмо с выбранной датой">
      <bpmn:documentation>Ответное письмо команде УЦ с подтверждением участия и выбранной датой.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendCreds" name="Показать успех и выдать логин и пароль">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Register" name="Зарегистрировать студента">
      <bpmn:documentation>Создание учётной записи, генерация логина и пароля.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_UC_di" bpmnElement="Participant_UC" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3200" height="900" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UC_di" bpmnElement="Lane_UC" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="3170" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LMS_di" bpmnElement="Lane_LMS" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="3170" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="3170" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="450" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="750" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Invite_di" bpmnElement="Task_Invite">
        <dc:Bounds x="2145" y="730" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fill_di" bpmnElement="Task_Fill">
        <dc:Bounds x="350" y="210" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Form_di" bpmnElement="StartEvent_Form">
        <dc:Bounds x="252" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="275" width="90" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveDate_di" bpmnElement="Task_ReceiveDate">
        <dc:Bounds x="2755" y="650" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success">
        <dc:Bounds x="3252" y="672" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3232" y="715" width="76" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="3080" y="650" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDate_di" bpmnElement="Task_SendDate">
        <dc:Bounds x="2605" y="210" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendCreds_di" bpmnElement="Task_SendCreds">
        <dc:Bounds x="660" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Tests_di" bpmnElement="SubProcess_Tests" isExpanded="true">
        <dc:Bounds x="920" y="100" width="520" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Sub_di" bpmnElement="Start_Sub">
        <dc:Bounds x="950" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Split_di" bpmnElement="Gw_Split">
        <dc:Bounds x="1030" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Survey_di" bpmnElement="Task_Survey">
        <dc:Bounds x="1120" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Test_di" bpmnElement="Task_Test">
        <dc:Bounds x="1120" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Case_di" bpmnElement="Task_Case">
        <dc:Bounds x="1120" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Join_di" bpmnElement="Gw_Join">
        <dc:Bounds x="1290" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Sub_di" bpmnElement="End_Sub">
        <dc:Bounds x="1370" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="S1_di" bpmnElement="S1">
        <di:waypoint x="986" y="250" />
        <di:waypoint x="1030" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S2_di" bpmnElement="S2">
        <di:waypoint x="1055" y="225" />
        <di:waypoint x="1055" y="160" />
        <di:waypoint x="1120" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S3_di" bpmnElement="S3">
        <di:waypoint x="1080" y="250" />
        <di:waypoint x="1120" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S4_di" bpmnElement="S4">
        <di:waypoint x="1055" y="275" />
        <di:waypoint x="1055" y="340" />
        <di:waypoint x="1120" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S5_di" bpmnElement="S5">
        <di:waypoint x="1220" y="160" />
        <di:waypoint x="1315" y="160" />
        <di:waypoint x="1315" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S6_di" bpmnElement="S6">
        <di:waypoint x="1220" y="250" />
